{
  "name": "evalunia",
  "version": "2.1.0",
  "description": "EVALUNIA",
  "main": "frontend/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "pack": "electron-builder --dir",
    "test": "jest --coverage",
    "test:frontend": "jest --config ./frontend/jest.frontend.config.js --coverage"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "lcov",
      "text"
    ],
    "collectCoverageFrom": [
      "frontend/**/*.js",
      "*.js",
      "!**/node_modules/**",
      "!**/dist/**",
      "!**/build/**",
      "!**/coverage/**"
    ]
  },
  "dependencies": {
    "@lmstudio/sdk": "^1.5.0",
    "bootstrap": "^5.3.5",
    "bootstrap-icons": "^1.11.3",
    "datatables.net": "^2.3.2",
    "datatables.net-bs5": "^2.3.2",
    "jquery": "^3.7.1",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "electron": "^39.8.3",
    "electron-builder": "^26.8.1",
    "electron-reloader": "^1.2.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^22.1.0",
    "standard": "^17.1.2"
  },
  "build": {
    "appId": "com.evalunia.app",
    "productName": "EVALUNIA",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "frontend/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/evalunia_backend",
        "to": "backend"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "frontend/img/logo.ico"
    },
    "nsis": {
       "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh"
    }
  }
}
